<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_tarjeta_producto"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/carrito_item_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_sobre_tarjeta"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/carrito_item_precio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/texto_sobre_tarjeta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/carrito_item_disminuir"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="−"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/carrito_item_cantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/texto_sobre_tarjeta"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/carrito_item_aumentar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="+"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/carrito_item_eliminar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/carrito_eliminar"
            android:textAllCaps="false"
            android:textColor="@color/error" />
    </LinearLayout>

    <TextView
        android:id="@+id/carrito_item_subtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:textColor="@color/acento_oscuro"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
