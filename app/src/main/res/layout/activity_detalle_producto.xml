<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_contenido"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/detalle_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fondo_header"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <ScrollView
            android:id="@+id/detalle_contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_producto"
                android:orientation="vertical"
                android:padding="24dp">

                <ViewFlipper
                    android:id="@+id/detalle_galeria_imagenes"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@color/fondo_contenido"
                    android:animateFirstView="false" />

                <TextView
                    android:id="@+id/detalle_imagen_indicador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/texto_secundario"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detalle_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detalle_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.35"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/detalle_precio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/acento"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detalle_disponibilidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/detalle_estado_carrito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_agregar_carrito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/acento"
                    android:text="@string/carrito_agregar"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_carrito"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/carrito_ver"
                    android:textAllCaps="false" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/detalle_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_estado_error"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/detalle_error_extras"
            android:textColor="@color/error_texto"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
