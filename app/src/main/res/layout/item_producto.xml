<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_tarjeta_producto"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/producto_imagen"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@color/fondo_contenido"
        android:contentDescription="@string/imagen_producto_descripcion"
        android:scaleType="center"
        android:src="@drawable/imagen_producto_placeholder" />

    <TextView
        android:id="@+id/producto_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_sobre_tarjeta"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Remera oficial" />

    <TextView
        android:id="@+id/producto_descripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.35"
        android:textColor="@color/texto_sobre_tarjeta"
        android:textSize="15sp"
        tools:text="Descripción del producto." />

    <TextView
        android:id="@+id/producto_precio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/acento"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:text="$ 25.000" />

    <TextView
        android:id="@+id/producto_disponibilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/texto_sobre_tarjeta"
        android:textSize="15sp"
        tools:text="Disponibilidad: 10" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/producto_agregar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/acento"
        android:text="@string/carrito_agregar"
        android:textAllCaps="false"
        app:cornerRadius="5dp" />

</LinearLayout>
