<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checkout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_contenido"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/checkout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fondo_header"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_producto"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/checkout_resumen_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkout_resumen_titulo"
                android:textColor="@color/texto_sobre_tarjeta"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/checkout_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/texto_sobre_tarjeta"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/checkout_form_mensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_estado"
                android:padding="12dp"
                android:textColor="@color/texto_claro"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/checkout_formulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/checkout_datos_titulo"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/checkout_datos_intro"
                    android:textColor="@color/texto_sobre_tarjeta" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/checkout_nombre"
                    android:text="@string/checkout_nombre"
                    android:textColor="@color/texto_sobre_tarjeta" />

                <EditText
                    android:id="@+id/checkout_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100"
                    android:singleLine="true"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textColorHint="@color/borde"
                    android:backgroundTint="@color/borde" />

                <TextView
                    android:id="@+id/checkout_error_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/checkout_apellido"
                    android:text="@string/checkout_apellido"
                    android:textColor="@color/texto_sobre_tarjeta" />

                <EditText
                    android:id="@+id/checkout_apellido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100"
                    android:singleLine="true"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textColorHint="@color/borde"
                    android:backgroundTint="@color/borde" />

                <TextView
                    android:id="@+id/checkout_error_apellido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@id/checkout_email"
                    android:text="@string/checkout_email"
                    android:textColor="@color/texto_sobre_tarjeta" />

                <EditText
                    android:id="@+id/checkout_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textColorHint="@color/borde"
                    android:backgroundTint="@color/borde" />

                <TextView
                    android:id="@+id/checkout_error_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_realizar_pedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/acento"
                    android:text="@string/checkout_realizar_pedido"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/checkout_resultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/checkout_resultado_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/checkout_resultado_mensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/checkout_codigo_grupo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/checkout_codigo"
                        android:text="@string/checkout_codigo_label"
                        android:textColor="@color/texto_sobre_tarjeta" />

                    <EditText
                        android:id="@+id/checkout_codigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/checkout_codigo_hint"
                        android:inputType="number"
                        android:maxLength="6"
                        android:singleLine="true"
                        android:textColor="@color/texto_sobre_tarjeta"
                        android:textColorHint="@color/borde"
                        android:backgroundTint="@color/borde" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkout_validar_codigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/acento"
                        android:text="@string/checkout_validar_codigo"
                        android:textAllCaps="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/checkout_correccion_detalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texto_sobre_tarjeta"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_aplicar_correccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/acento"
                    android:text="@string/checkout_aplicar_correccion"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_reenviar_email"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/checkout_reenviar_codigo"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_pagar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/acento"
                    android:text="@string/checkout_pagar"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkout_finalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/acento"
                    android:text="@string/checkout_entendido"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkout_volver_carrito"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/checkout_volver_carrito"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
